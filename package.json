{
  "name": "codebase-mcp-bridge",
  "version": "1.0.0",
  "description": "Compact MCP bridge for code search, file edits, Git, and validation",
  "main": "dist/server.js",
  "scripts": {
    "test": "npm run typecheck && node --import tsx --test tests/**/*.test.ts",
    "dev": "tsx src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "lint": "tsc -p tsconfig.json --noEmit",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint:scripts": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/validate-powershell-syntax.ps1",
    "stdio": "tsx src/stdio.ts",
    "start:stdio": "node dist/stdio.js",
    "mcp:install": "node scripts/manage-mcp.js install",
    "mcp:uninstall": "node scripts/manage-mcp.js uninstall",
    "mcp:sync": "node scripts/sync-mcp-clients.js",
    "chatgpt:register": "powershell -ExecutionPolicy Bypass -File scripts/register-chatgpt-client.ps1",
    "workspace": "tsx src/workspace-cli.ts"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "llm",
    "ai-agents",
    "code-search",
    "git",
    "typescript"
  ],
  "author": "Boutros Tawaifi",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "fast-glob": "^3.3.3",
    "minimatch": "^10.2.5",
    "typescript": "^6.0.3",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^25.6.2",
    "tsx": "^4.21.0"
  }
}
