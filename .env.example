BRIDGE_PUBLIC_URL=https://your-tunnel.example.com
BRIDGE_PORT=3030

BRIDGE_DEPLOY_COMMAND=npm run build
BRIDGE_YOLO_ENABLED=true
BRIDGE_YOLO_OPERATIONS=write_file,replace_text,replace_text_batch,apply_patch,apply_unified_diff,delete_path,git_commit,rollback_operation
BRIDGE_ALLOW_UNAUTHENTICATED_LOCAL=false
BRIDGE_OAUTH_SETUP_SECRET=
BRIDGE_REQUIRE_CLIENT_SECRET=true
BRIDGE_HEALTH_INCLUDE_REPO_ROOT=false
BRIDGE_SECURITY_STRICT=false
#$env:BRIDGE_OAUTH_SETUP_SECRET = [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
