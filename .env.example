# Copy to .env and adjust. Every value shown is the default unless noted.

# --- HTTP server ---
BRIDGE_PORT=3030
# Public HTTPS URL clients use (tunnel); also the OAuth issuer. Defaults to http://localhost:<port>.
BRIDGE_PUBLIC_URL=https://your-tunnel.example.com
# Repository served when no workspaceId is given. Defaults to the launch directory.
# BRIDGE_REPO_ROOT=C:\path\to\repo

# --- OAuth ---
# Required for client registration (register-chatgpt-client.ps1). Generate one in PowerShell:
#   [Convert]::ToBase64String((1..32 | ForEach-Object { Get-Random -Maximum 256 }))
BRIDGE_OAUTH_SETUP_SECRET=
BRIDGE_REQUIRE_CLIENT_SECRET=true
# Skip OAuth for local HTTP only; does not unlock git.push or command.run.
BRIDGE_ALLOW_UNAUTHENTICATED_LOCAL=false

# --- Risk controls ---
BRIDGE_SECURITY_STRICT=false
BRIDGE_ALLOW_HIGH_RISK_HTTP=false
BRIDGE_ENABLE_COMMAND_RUN=false
BRIDGE_MAX_COMMAND_OUTPUT_BYTES=50000

# --- Limits ---
BRIDGE_MAX_FILE_BYTES=250000
BRIDGE_MAX_SEARCH_RESULTS=500
BRIDGE_MAX_CONTEXT_FILES=12

# --- Search backend (ripgrep) ---
# BRIDGE_RG_PATH=C:\path\to\rg.exe
# Default 750 on Windows, 250 elsewhere.
# BRIDGE_RG_SEARCH_TIMEOUT_MS=750
# BRIDGE_RG_TIMEOUT_COOLDOWN_MS=5000

# --- Diagnostics ---
BRIDGE_ENABLE_AUDIT=false
BRIDGE_HEALTH_INCLUDE_REPO_ROOT=false
# Security details in /health are always included when the public URL is localhost.
BRIDGE_HEALTH_INCLUDE_SECURITY=false
# BRIDGE_INSTANCE_ID=
# BRIDGE_INSTANCE_NAME=
# CODEBASE_MCP_WORKSPACE_MANIFEST=C:\path\to\manifest.json

# --- Scripts only ---
# Default ChatGPT connection name for start-all.ps1, and a cloudflared binary not on PATH.
# BRIDGE_CLIENT_NAME=PC_CON
# CLOUDFLARED_PATH=C:\path\to\cloudflared.exe
